# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=postgres://saep:saep@localhost:5432/wms_saep

# CORS (development only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Implantação piloto (config.settings.piloto)
#
# As variáveis abaixo só valem para o piloto. Em dev elas são ignoradas — não
# descomente nada aqui para rodar localmente.
#
# O piloto recusa a inicialização se qualquer uma delas estiver ausente, vazia
# ou permissiva. É de propósito: cada uma dessas configurações falha em silêncio
# quando mal preenchida, e o erro só aparece como incidente.
# ---------------------------------------------------------------------------

# DJANGO_SETTINGS_MODULE=config.settings.piloto

# SECRET_KEY tem regra executável, cobrada por `manage.py check --deploy`
# (security.W009): no mínimo 50 caracteres, ao menos 5 caracteres distintos e
# sem o prefixo `django-insecure-`. Gere uma nova, nunca reaproveite a de dev.
# SECRET_KEY=troque-por-uma-chave-aleatoria-de-50-caracteres-ou-mais

# Obrigatória, sem default. Liste os domínios reais; o curinga `*` é recusado
# no boot, porque delegaria a validação de Host header a um proxy que esta
# configuração não garante existir.
# ALLOWED_HOSTS=piloto.exemplo.gov.br,www.piloto.exemplo.gov.br

# Obrigatória, sem default. Cada origem precisa incluir o esquema.
# CSRF_TRUSTED_ORIGINS=https://piloto.exemplo.gov.br

# Obrigatória e obrigatoriamente PostgreSQL: o boot falha com `sqlite://` ou
# qualquer outro backend. Em SQLite o `select_for_update` das transições de
# requisição (ADR-0005) vira no-op silencioso.
# DATABASE_URL=postgres://usuario:senha@host:5432/wms_saep_piloto

# HSTS em segundos. Default de 1 hora, curto de propósito: o cabeçalho fica
# gravado no navegador de quem visitou e não pode ser revogado remotamente.
# Suba por etapas (3600 -> 86400 -> 604800 -> 31536000) depois de confirmar que
# todo o tráfego funciona em HTTPS.
# PILOTO_HSTS_SECONDS=3600

# Ligue APENAS se houver um proxy à frente que termine TLS e sobrescreva o
# cabeçalho `X-Forwarded-Proto`. Sem esse proxy, ligar isto permite que
# qualquer cliente se declare HTTPS; deixá-lo desligado atrás de um proxy
# causa laço de redirecionamento por causa do SECURE_SSL_REDIRECT.
# PILOTO_ATRAS_DE_PROXY_TLS=false
